/* ---------- Termine ----------------------------------------------------
   von/bis stehen in den Daten als leere Felder. Die Woche wird deshalb aus
   `termin` gewonnen — „31.08.–04.09.2026" und „21.–25.09.2026" sind beide
   gueltige Schreibweisen. Ohne das haelt die Seite jede Woche fuer kuenftig
   und klappt die falsche auf.                                            */
function termin(t, w){
  /* Sind `von` und `bis` eines Tages gefuellt, gelten sie. */
  if (w && w.von && w.bis)
    return {von:new Date(w.von+"T00:00:00"), bis:new Date(w.bis+"T23:59:59")};
  const teil = String(t || "").split(/[–—]/);
  const r = /(\d{1,2})\.(\d{1,2})\.(\d{4})/.exec(teil[1] || "");
  if (!r) return null;
  const jahr = +r[3], bisM = +r[2], bisT = +r[1];
  const l = /(\d{1,2})\.(?:(\d{1,2})\.)?/.exec(teil[0] || "");
  if (!l) return null;
  const vonT = +l[1], vonM = l[2] ? +l[2] : bisM;
  return {
    von: new Date(vonM > bisM ? jahr - 1 : jahr, vonM - 1, vonT),
    bis: new Date(jahr, bisM - 1, bisT, 23, 59, 59)
  };
}
