<style>
/* Farben und Schriften des Turnusplans — gleiche Werte wie die Schuelertafel,
   damit beide Apps nebeneinander wie ein Haus aussehen. */
/* Corporate Design der Listschule Halle (Saale), Design Manual 02.01.2023 – erzeugt von Werkzeug/cd/cd.py */
@font-face{font-family:"Montserrat CD";font-style:normal;font-weight:400 700;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
:root{
  --cd-dunkelgruen:#223D42; --cd-gruen:#6FA895; --cd-sek1:#CDD9DF; --cd-sek2:#CEE3DD; --cd-sek3:#E9F1ED;
  --cd-grund:#E9F1ED; --cd-flaeche:#FFFFFF; --cd-sunk:#E9F1ED; --cd-rand:#CDD9DF;
  --cd-text:#223D42; --cd-text2:color-mix(in srgb,#223D42 84%,#FFFFFF); --cd-leise:color-mix(in srgb,#223D42 74%,#FFFFFF);
  --cd-leit:#223D42; --cd-auf-leit:#FFFFFF; --cd-akzent:#6FA895; --cd-akzent-text:#223D42; --cd-akzent-hell:#CEE3DD;
  --cd-fokus:#223D42; --cd-link:#223D42;
  --cd-ok:#223D42; --cd-ok-flaeche:#CEE3DD; --cd-ok-rand:#6FA895;
  --cd-teilweise:#8A6A12; --cd-teilweise-flaeche:color-mix(in srgb,#8A6A12 13%,#FFFFFF);
  --cd-falsch:#A23B2C; --cd-falsch-flaeche:color-mix(in srgb,#A23B2C 11%,#FFFFFF);
  --cd-schatten:0 1px 2px color-mix(in srgb,#223D42 8%,transparent),0 4px 14px color-mix(in srgb,#223D42 7%,transparent);
  --cd-logo-1:#003A40; --cd-logo-2:#1F4744; --cd-logo-3:#49A893;
  --cd-schrift:"Montserrat CD","Montserrat",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  --cd-mono:ui-monospace,"SF Mono","Cascadia Mono",Consolas,"Roboto Mono",monospace;}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --cd-grund:color-mix(in srgb,#223D42 55%,#000000); --cd-flaeche:color-mix(in srgb,#223D42 80%,#000000); --cd-sunk:color-mix(in srgb,#223D42 45%,#000000);
  --cd-rand:color-mix(in srgb,#223D42 74%,#FFFFFF);
  --cd-text:#E9F1ED; --cd-text2:color-mix(in srgb,#E9F1ED 86%,#223D42); --cd-leise:color-mix(in srgb,#E9F1ED 72%,#223D42);
  --cd-leit:#CEE3DD; --cd-auf-leit:#223D42; --cd-akzent:#6FA895; --cd-akzent-text:#CEE3DD; --cd-akzent-hell:color-mix(in srgb,#6FA895 26%,#223D42);
  --cd-fokus:#CEE3DD; --cd-link:#CEE3DD;
  --cd-ok:#CEE3DD; --cd-ok-flaeche:color-mix(in srgb,#6FA895 30%,#223D42); --cd-ok-rand:#6FA895;
  --cd-teilweise:#E2C36B; --cd-teilweise-flaeche:color-mix(in srgb,#E2C36B 16%,#223D42);
  --cd-falsch:#EE9A8A; --cd-falsch-flaeche:color-mix(in srgb,#EE9A8A 16%,#223D42);
  --cd-schatten:0 1px 2px color-mix(in srgb,#000000 30%,transparent);
  --cd-logo-1:#FFFFFF; --cd-logo-2:#FFFFFF; --cd-logo-3:#FFFFFF; color-scheme:dark;}}
:root[data-theme="dark"]{
  --cd-grund:color-mix(in srgb,#223D42 55%,#000000); --cd-flaeche:color-mix(in srgb,#223D42 80%,#000000); --cd-sunk:color-mix(in srgb,#223D42 45%,#000000);
  --cd-rand:color-mix(in srgb,#223D42 74%,#FFFFFF);
  --cd-text:#E9F1ED; --cd-text2:color-mix(in srgb,#E9F1ED 86%,#223D42); --cd-leise:color-mix(in srgb,#E9F1ED 72%,#223D42);
  --cd-leit:#CEE3DD; --cd-auf-leit:#223D42; --cd-akzent:#6FA895; --cd-akzent-text:#CEE3DD; --cd-akzent-hell:color-mix(in srgb,#6FA895 26%,#223D42);
  --cd-fokus:#CEE3DD; --cd-link:#CEE3DD;
  --cd-ok:#CEE3DD; --cd-ok-flaeche:color-mix(in srgb,#6FA895 30%,#223D42); --cd-ok-rand:#6FA895;
  --cd-teilweise:#E2C36B; --cd-teilweise-flaeche:color-mix(in srgb,#E2C36B 16%,#223D42);
  --cd-falsch:#EE9A8A; --cd-falsch-flaeche:color-mix(in srgb,#EE9A8A 16%,#223D42);
  --cd-schatten:0 1px 2px color-mix(in srgb,#000000 30%,transparent);
  --cd-logo-1:#FFFFFF; --cd-logo-2:#FFFFFF; --cd-logo-3:#FFFFFF; color-scheme:dark;}
.cd-logo{display:block;height:auto}.cd-logo .cdl-1{fill:var(--cd-logo-1)}.cd-logo .cdl-2{fill:var(--cd-logo-2)}.cd-logo .cdl-3{fill:var(--cd-logo-3)}.cd-icon{display:block}.cd-icon path{fill:none;stroke:currentColor;stroke-miterlimit:10;stroke-width:2.33px}
/* Corporate Design der Listschule Halle (Saale), Entscheidung Christian 10.10.2026:
   Grund, Schrift, Linien und Knöpfe aus den --cd-*-Werten (cd/cd.py); hell/dunkel schalten dort.
   Ausnahme: Die sieben Fachfarben bleiben zur Orientierung, wie im gedruckten Turnusplan. */
:root{
  --ground:var(--cd-grund); --surface:var(--cd-flaeche); --sunk:var(--cd-sunk);
  --ink:var(--cd-text); --ink2:var(--cd-text2); --muted:var(--cd-leise);
  --line:var(--cd-rand); --line2:color-mix(in srgb,var(--cd-rand) 72%,var(--cd-text)); --focus:var(--cd-fokus);
  --lf1:#204A50; --sk:#2F7A5E; --lf2:#33507C; --lf3:#A8861B;
  --de:#A03A2A; --lf4:#6E3AA8; --lf5:#BC2A6E;
  --tint-a:11%; --tint-b:21%; --tint-c:34%;
  --sans:var(--cd-schrift); --serif:var(--cd-schrift); --mono:var(--cd-schrift);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --lf1:#3E9CB0; --sk:#6DAC46; --lf2:#6E8ED4; --lf3:#D6AC2E;
  --de:#C55C58; --lf4:#9A6EDC; --lf5:#DB5690;
  --tint-a:12%; --tint-b:20%; --tint-c:30%;
}}
:root[data-theme="dark"]{
  --lf1:#3E9CB0; --sk:#6DAC46; --lf2:#6E8ED4; --lf3:#D6AC2E;
  --de:#C55C58; --lf4:#9A6EDC; --lf5:#DB5690;
  --tint-a:12%; --tint-b:20%; --tint-c:30%;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);
  font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased;font-feature-settings:"lnum";font-variant-numeric:lining-nums}
/* Markenleiste: Logo der Listschule (Version 1, im Dunkeln weiß) und Schule */
.marke{display:flex;align-items:center;justify-content:space-between;gap:10px 20px;flex-wrap:wrap;
  padding:0 0 12px;margin:0 0 22px;border-bottom:3px solid var(--cd-akzent)}
.marke .cd-logo{width:clamp(160px,38vw,215px)}
.marke-text{font-size:12.5px;font-weight:600;color:var(--muted);text-align:right;line-height:1.35}
@media (max-width:480px){.marke-text{display:none}}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.wrap{max-width:1080px;margin:0;padding:26px 18px 70px}
/* Ab Tabletbreite etwas Luft zum linken Fensterrand */
@media (min-width:760px){.wrap{padding-left:32px;padding-right:32px}}

h1{font-family:var(--serif);font-size:28px;font-weight:700;line-height:1.15;
  margin:0 0 6px;letter-spacing:-.012em;text-wrap:balance}
.unter{color:var(--ink2);font-size:14px;margin:0 0 20px;max-width:62ch}
.eyebrow{font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.09em;
  text-transform:uppercase;color:var(--muted);margin:0 0 7px}

/* Hinweiskasten — sagt, wo die Rueckmeldungen liegen und wie sie herauskommen */
.privat{border:2px solid var(--ink);background:var(--surface);padding:15px 17px;margin-bottom:20px}
.privat p{margin:0;font-size:13.5px;line-height:1.55;color:var(--ink2);max-width:80ch}
.privat p+p{margin-top:8px}
.privat b{color:var(--ink)}
.privat .zeile{display:flex;flex-wrap:wrap;gap:9px;margin-top:13px}
/* Die lange Fassung steht bereit, nimmt aber nicht jedes Mal den halben
   ersten Bildschirm ein — die Seite wird in jeder Blockwoche geoeffnet. */
.privat .mehr{margin-top:9px}
.privat .mehr > summary{cursor:pointer;list-style:none;font-family:var(--mono);
  font-size:11px;letter-spacing:.04em;color:var(--muted);text-decoration:underline;
  text-underline-offset:3px}
.privat .mehr > summary::-webkit-details-marker{display:none}
.privat .mehr > summary::before{content:"+ ";font-weight:700}
.privat .mehr[open] > summary::before{content:"– "}
.privat .mehr > summary:hover{color:var(--ink)}
.privat .mehr p{margin-top:9px}
button.knopf{font:600 13px/1 var(--sans);color:var(--ink);background:var(--surface);
  border:1.5px solid var(--line2);padding:8px 12px;cursor:pointer}
button.knopf:hover{border-color:var(--ink);background:var(--sunk)}
button.knopf.warn:hover{border-color:var(--de);color:var(--de)}
button.knopf[disabled]{opacity:.45;cursor:default}
button.knopf[disabled]:hover{border-color:var(--line2);background:var(--surface)}

/* Wer bin ich, und was sehe ich */
.werleiste{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;
  border:1px solid var(--line);background:var(--surface);padding:11px 15px;margin-bottom:18px}
.werleiste label{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;
  text-transform:uppercase;color:var(--muted)}
.werleiste select{font:600 14px/1 var(--sans);color:var(--ink);background:var(--surface);
  border:1.5px solid var(--line2);padding:6px 8px}
.werleiste select.gesetzt{border-color:var(--focus)}
.werleiste .fmein{display:flex;gap:0;margin-left:auto}
.werleiste .fmein button{font:600 12px/1 var(--mono);color:var(--ink2);background:var(--surface);
  border:1.5px solid var(--line2);padding:7px 11px;cursor:pointer;margin-left:-1.5px}
.werleiste .fmein button[aria-pressed="true"]{background:var(--ink);color:var(--ground);
  border-color:var(--ink);position:relative;z-index:1}
.werleiste .meine{font-family:var(--mono);font-size:11px;color:var(--muted);flex-basis:100%}

/* Fortschritt */
.kacheln{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0;
  border:1px solid var(--line);background:var(--surface);margin-bottom:24px}
.kachel{padding:13px 15px;border-right:1px solid var(--line);border-top:1px solid var(--line)}
.kachel:nth-child(-n+4){border-top:0}
.kachel:last-child{border-right:0}
.kachel .zahl{font-family:var(--serif);font-size:28px;font-weight:600;line-height:1.05;
  letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.kachel .zahl small{font-family:var(--mono);font-size:12px;font-weight:400;color:var(--muted);
  letter-spacing:0}
.kachel .satz{font-size:12px;color:var(--ink2);margin-top:4px;line-height:1.4}

/* Wochen */
.woche{border:1px solid var(--line);background:var(--surface);margin-bottom:14px}
.woche.vorbei{opacity:.72}
.woche > summary{list-style:none;cursor:pointer;padding:13px 16px;
  display:flex;align-items:baseline;gap:13px;flex-wrap:wrap}
.woche > summary::-webkit-details-marker{display:none}
.woche > summary:hover{background:var(--sunk)}
.wnr{font-family:var(--serif);font-size:26px;font-weight:600;line-height:1;
  font-variant-numeric:tabular-nums;min-width:34px}
.wtermin{font-family:var(--mono);font-size:12.5px;color:var(--ink2)}
.wstand{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--muted);
  white-space:nowrap}
.wstand b{color:var(--ink);font-weight:600}
.wkurz{flex-basis:100%;font-size:12.5px;color:var(--de);font-weight:500}
.woche[open] > summary{border-bottom:1px solid var(--line);background:var(--sunk)}
.jetzt{border-width:2px;border-color:var(--ink)}
.jetzt .wnr::after{content:" ▸";font-size:15px;vertical-align:2px}

/* Fachblock innerhalb einer Woche */
.fblock{border-top:1px solid var(--line);padding:11px 16px 13px;border-left:4px solid var(--f)}
.fblock:first-of-type{border-top:0}
.fkopf{display:flex;align-items:baseline;gap:9px;margin-bottom:8px;flex-wrap:wrap}
.fkopf .fn{font-weight:600;font-size:13.5px}
.fkopf .flk{font-family:var(--mono);font-size:11px;color:var(--muted);margin-left:auto}
.fblock.fremd{opacity:.78}

/* Karten — Stoff, Leistung, Strecke. Eine Karte, ein Haken, ein Bogen. */
.karten{display:grid;gap:6px}
.karte{position:relative;display:block;width:100%;text-align:left;font:inherit;color:var(--ink);
  cursor:pointer;background:var(--surface);border:1.5px solid var(--line2);
  border-left:4px solid var(--f);padding:7px 30px 8px 10px;transition:box-shadow .12s}
.karte:hover{box-shadow:0 0 0 2px var(--f) inset}
.karte .kkenn{display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;
  color:var(--muted)}
.karte .ktitel{display:block;font-size:12.5px;line-height:1.35;color:var(--ink2);margin-top:2px}
.karte .kbogen{display:block;font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:3px}
.karte .khaken{position:absolute;top:6px;right:7px;width:18px;height:18px;display:grid;
  place-items:center;font-size:11px;font-weight:700;border-radius:50%;
  background:var(--f);color:var(--surface)}
.karte[data-s=""] .khaken,.karte:not([data-s]) .khaken{display:none}
.karte[data-s="gehalten"],.karte[data-s="geschrieben"],.karte[data-s="geschafft"]{
  background:color-mix(in oklab,var(--f) var(--tint-a),var(--surface));border-color:var(--f)}
.karte[data-s="zurueck"],.karte[data-s="ausgegeben"],.karte[data-s="teilweise"]{
  background:color-mix(in oklab,var(--f) calc(var(--tint-a) / 2),var(--surface));
  border-color:var(--f);border-style:dashed;border-left-style:solid}
.karte[data-s="verschoben"]{background:var(--sunk);border-style:dotted;border-left-style:solid}
.karte[data-s="entfallen"]{background:var(--sunk)}
.karte[data-s="entfallen"] .kkenn{text-decoration:line-through;text-decoration-thickness:1.5px}
.karte[data-s="entfallen"] .ktitel,.karte[data-s="verschoben"] .ktitel{opacity:.6}
.karte.leistung{border-radius:0 10px 10px 0;background:var(--sunk)}
.karte.strecke{border-left-style:dashed}
.kmarke{display:inline-block;font-family:var(--mono);font-size:9.5px;font-weight:600;
  border:1px solid var(--f);padding:0 4px;margin-right:5px;vertical-align:1px}
.karte.verwaist{border-color:var(--de);border-style:dashed}
.karte.verwaist .kkenn::after{content:" · verwaist";color:var(--de)}

/* Wochenrueckblick */
.rueck{border-top:1px solid var(--line);background:var(--sunk);padding:10px 16px 11px}
.rueck button{width:100%;text-align:left;font:inherit;color:var(--ink);background:none;
  border:0;padding:0;cursor:pointer}
.rueck .reyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;
  text-transform:uppercase;color:var(--muted)}
.rueck .rtext{font-size:12.5px;color:var(--ink2);margin-top:3px;line-height:1.45}
.rueck .rleer{color:var(--muted);font-style:italic}

/* Der Bogen — halb hohes Blatt ueber der Seite */
.hg{position:fixed;inset:0;background:color-mix(in srgb,#223D42 55%,transparent);z-index:40;
  display:flex;align-items:flex-end;justify-content:center;overflow-y:auto}
/* Diese Zeile ist nicht schmueckend, sondern traegt die ganze Bedienung:
   das Attribut `hidden` bekommt sein display:none vom Browser, und jede
   eigene display-Angabe schlaegt das. Ohne sie liegt der Hintergrund des
   Bogens dauerhaft ueber der Seite - halbdurchsichtig, also kaum zu sehen -
   und faengt jeden Klick ab: Auswahlfeld, Knoepfe, Karten, alles tot.
   Aufgefallen am 23.09.2026 in der Teams-Registerkarte. Nicht aufgefallen
   war es vorher, weil jede Pruefung element.click() aus JavaScript gerufen
   hat, und das umgeht die Trefferpruefung.
   VORFASSUNG: lehrkraft.tpl.html.vor_klicksperre_23092026 */
.hg[hidden]{display:none}
@media (min-width:640px){.hg{align-items:center;padding:20px}}
.bogen{background:var(--surface);color:var(--ink);border:2px solid var(--ink);
  width:min(560px,100%);max-height:92vh;overflow-y:auto;padding:18px 20px 22px;
  border-left:6px solid var(--f)}
.bogen .schliessen{float:right;font:600 12px/1 var(--sans);color:var(--ink2);
  background:var(--surface);border:1.5px solid var(--line2);padding:6px 10px;cursor:pointer}
.bogen .bkenn{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;
  text-transform:uppercase;color:var(--muted)}
.bogen h2{font-family:var(--serif);font-size:19px;font-weight:600;margin:4px 0 6px;
  line-height:1.2;clear:none}
.bogen .bmeta{font-size:12px;color:var(--muted);line-height:1.45;margin-bottom:14px}
.bogen h3{font-family:var(--mono);font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;
  color:var(--muted);margin:16px 0 7px;font-weight:600}
.leiter{list-style:none;margin:0;padding:0;display:grid;gap:5px}
.leiter button{position:relative;width:100%;text-align:left;font:inherit;color:var(--ink);
  background:var(--surface);border:1.5px solid var(--line2);padding:8px 34px 8px 10px;
  cursor:pointer;display:flex;gap:9px;align-items:flex-start}
.leiter button:hover{border-color:var(--ink)}
.leiter button[aria-pressed="true"]{border-color:var(--f);border-width:2px;
  background:color-mix(in oklab,var(--f) var(--tint-a),var(--surface))}
.leiter .stufe{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--muted);
  border:1px solid var(--line2);width:17px;height:17px;display:grid;place-items:center;flex:none;
  margin-top:1px}
.leiter button[aria-pressed="true"] .stufe{border-color:var(--f);color:var(--ink)}
.leiter .haken{position:absolute;top:8px;right:9px;font-size:13px;font-weight:700;color:var(--f)}
.leiter .lbl{font-size:13.5px;font-weight:600}
.leiter .erkl{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:1px}
.achse{margin-bottom:11px}
.achse .afrage{font-family:var(--mono);font-size:10.5px;color:var(--muted);margin-bottom:4px}
.achse .awerte{display:flex;gap:0;flex-wrap:wrap}
.achse .awerte button{font:500 12.5px/1 var(--sans);color:var(--ink2);background:var(--surface);
  border:1.5px solid var(--line2);padding:7px 10px;cursor:pointer;margin-left:-1.5px}
.achse .awerte button:first-child{margin-left:0}
.achse .awerte button[aria-pressed="true"]{background:color-mix(in oklab,var(--f) var(--tint-b),var(--surface));
  border-color:var(--f);color:var(--ink);font-weight:600;position:relative;z-index:1}
.bogen textarea{width:100%;min-height:86px;font:inherit;font-size:13px;color:var(--ink);
  background:var(--sunk);border:1.5px solid var(--line2);padding:8px;resize:vertical}
.bogen textarea:focus{border-color:var(--focus)}
.bogen .zaehler{font-family:var(--mono);font-size:10px;color:var(--muted);text-align:right;
  margin-top:2px}
.bogen .spur{font-family:var(--mono);font-size:10.5px;color:var(--muted);margin-top:14px;
  border-top:1px solid var(--line);padding-top:9px}
.bogen .bzeile{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}

.fuss{margin-top:34px;padding-top:16px;border-top:1px solid var(--line);
  font-size:12.5px;color:var(--muted);line-height:1.6}
.fuss b{color:var(--ink2)}
.ds-link{color:var(--muted);text-decoration:underline;text-underline-offset:2px}
.ds-link:hover{color:var(--ink2)}
dialog{border:2px solid var(--ink);background:var(--surface);color:var(--ink);
  padding:20px 22px;max-width:min(620px,92vw);font-family:var(--sans)}
dialog::backdrop{background:color-mix(in srgb,#223D42 55%,transparent)}
dialog h2{font-family:var(--serif);font-size:19px;margin:0 0 10px}
dialog textarea{width:100%;min-height:150px;font-family:var(--mono);font-size:11.5px;
  color:var(--ink);background:var(--sunk);border:1px solid var(--line2);padding:8px}
dialog p{font-size:13px;color:var(--ink2);line-height:1.5}

@media print{
  body{background:#fff;color:#000;font-size:11pt}
  .privat .zeile,.knopf,.werleiste .fmein,dialog,.hg{display:none!important}
  .woche{break-inside:avoid;border-color:#CDD9DF}
  .woche > summary{background:#E9F1ED!important}
  details{display:block}
  details > summary{list-style:none}
}
