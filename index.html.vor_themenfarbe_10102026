    ? "Ihre Fächer: " + f.map(x => x.name).join(", ")
    : "Für " + wer + " ist in dieser Variante kein Fach eingetragen.";
}
werFeld.addEventListener("change", () => {
  wer = werFeld.value;
  try { localStorage.setItem(S_WER, wer); } catch(e){}
  werFeld.classList.toggle("gesetzt", !!wer);
