/* ---------- Bericht ------------------------------------------------------ */
function berichtMd(){
  const z = [];
  const n = Object.keys(eintraege).filter(k => gefuellt(eintraege[k])).length;
  z.push("# Rückmeldung KVF 26" + (wer ? " · " + wer : ""));
  z.push("");
  z.push("Turnusplan " + VARIANTE + ", Datenstand " + STAND
    + " · ausgegeben am " + new Date().toLocaleDateString("de-DE",
        {day:"2-digit", month:"2-digit", year:"numeric"})
    + " · " + n + (n === 1 ? " Eintrag" : " Einträge"));
  WOCHEN.forEach(w => {
    const rw = holen(kWoche(w));
    const gruppen = faecherDer(w.nr).map(g => {
      const zeilen = []
        .concat(g.bausteine.map(b => [kBaustein(b), b.id]))
        .concat(g.leistungen.map(l => [kLeistung(l), l.art + (l.nr ? " " + l.nr : "")]))
        .concat(g.strecken.map(s => [kStrecke(s), s.blatt]))
        .filter(p => gefuellt(holen(p[0])));
      return {f:g.f, zeilen:zeilen};
    }).filter(g => g.zeilen.length);
    if (!gruppen.length && !gefuellt(rw)) return;
    z.push(""); z.push("## Blockwoche " + w.nr + " · " + w.termin);
    if (w.kurz){ z.push(""); z.push("*" + w.kurz + "*"); }
    if (gefuellt(rw)){
      z.push("");
      z.push("**Rückblick:** " + [rw.takt ? "Takt " + achseName("woche","takt",rw.takt) : "", rw.text || ""]
        .filter(Boolean).join(" — "));
    }
    gruppen.forEach(g => {
      z.push(""); z.push("### " + g.f.name + (g.f.lk ? " · " + g.f.lk : ""));
      z.push("");
      g.zeilen.forEach(p => {
        const e = holen(p[0]);
        const kopf = ["**" + p[1] + "**", e.status ? stufeName(e.art, e.status) : ""]
          .concat((ACHSEN[e.art] || []).map(a => e[a.feld] ? a.frage + " " + achseName(e.art, a.feld, e[a.feld]) : ""))
          .filter(Boolean).join(" · ");
        z.push("- " + kopf + " — " + (e.titel || "").replace(/\s+/g, " "));
        if (e.text) z.push("  - Vermerk: " + e.text.replace(/\n+/g, " "));
      });
    });
  });
  const v = verwaist();
  if (v.length){
    z.push(""); z.push("## Verwaist");
    z.push("");
    z.push("Kennungen, die es im Turnusplan " + VARIANTE + " nicht mehr gibt.");
    z.push("");
    v.forEach(k => {
      const e = eintraege[k];
      z.push("- **" + k.replace(/^[blsw]:/, "") + "** " + (e.status ? stufeName(e.art, e.status) : "")
        + " — " + (e.titel || "(ohne Titel)"));
      if (e.text) z.push("  - Vermerk: " + e.text.replace(/\n+/g, " "));
    });
  }
  if (!n) { z.push(""); z.push("*Noch nichts eingetragen.*"); }
  z.push("");
  return z.join("\n");
}
function ausgabe(){
  return {
    app:"KVF Lehrkraft", fassung:1,
    variante:VARIANTE, stand:STAND,
    wer: wer || "", erstellt:new Date().toISOString(),
    eintraege: Object.fromEntries(Object.keys(eintraege)
      .filter(k => gefuellt(eintraege[k])).map(k => [k, eintraege[k]]))
  };
}
const dateiName = endung =>
  "KVF_Rueckmeldung_" + (wer || "ohne_Namen").replace(/[^\p{L}\d]/gu, "_")
  + "_" + new Date().toISOString().slice(0, 10) + "." + endung;
function speichern(text, name, typ){
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([text], {type:typ}));
  a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 4000);
}

/* ---------- Ausgeben, einlesen, leeren ----------------------------------- */
const dlg    = document.getElementById("dlg");
const feld   = document.getElementById("dlg-feld");
const dTitel = document.getElementById("dlg-titel");
const dText  = document.getElementById("dlg-text");
const dOk    = document.getElementById("dlg-ok");
const dDatei = document.getElementById("dlg-datei");
const dFile  = document.getElementById("dlg-file");
const dInput = document.getElementById("dlg-input");
let modus = "ausgeben";

function hinweis(text){
  modus = "hinweis";
  dTitel.textContent = "Hinweis";
  dText.textContent = text;
  feld.value = ""; feld.hidden = true;
  dOk.hidden = true; dDatei.hidden = true; dFile.hidden = true;
  if (!dlg.open) dlg.showModal();
}

document.getElementById("b-ausgeben").addEventListener("click", () => {
  modus = "ausgeben";
  dTitel.textContent = "Rückmeldung ausgeben";
  dText.textContent = "Das ist Ihre Rückmeldung als Datei — zugleich Ihre Sicherung. "
    + "Speichern und an Christian geben; dort werden die Rückmeldungen aller fünf zusammengelegt. "
    + "Wer lieber kopiert: der Text unten ist derselbe Inhalt.";
  feld.value = JSON.stringify(ausgabe(), null, 1);
  feld.hidden = false; feld.readOnly = false;
  dOk.hidden = true; dDatei.hidden = false; dFile.hidden = true;
  dlg.showModal(); feld.select();
});

document.getElementById("b-bericht").addEventListener("click", () => {
  modus = "bericht";
  dTitel.textContent = "Bericht";
  dText.textContent = "Ihre Einträge als lesbarer Bericht, nach Blockwochen geordnet. "
    + "Lässt sich speichern, ausdrucken oder in eine Mail kopieren.";
  feld.value = berichtMd();
  feld.hidden = false; feld.readOnly = true;
  dOk.hidden = true; dDatei.hidden = false; dFile.hidden = true;
  dlg.showModal();
});

document.getElementById("b-laden").addEventListener("click", () => {
  modus = "laden";
  dTitel.textContent = "Sicherung einlesen";
  dText.textContent = "Wählen Sie die Datei, oder fügen Sie ihren Inhalt unten ein. "
    + "Die eingelesenen Einträge werden mit den vorhandenen zusammengelegt; bei derselben "
    + "Kennung gilt der jüngere Eintrag.";
  feld.value = ""; feld.hidden = false; feld.readOnly = false;
  dOk.hidden = false; dDatei.hidden = true; dFile.hidden = false;
  dlg.showModal(); dFile.focus();
});

dFile.addEventListener("click", () => dInput.click());
dInput.addEventListener("change", () => {
  const f = dInput.files && dInput.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = () => { feld.value = String(r.result || ""); einlesen(); };
  r.onerror = () => { dText.textContent = "Die Datei ließ sich nicht lesen."; };
  r.readAsText(f);
  dInput.value = "";
});

function einlesen(){
  let x;
  try { x = JSON.parse(feld.value); } catch(e){
    dText.textContent = "Das war keine gültige Datei. Fügen Sie den ganzen Inhalt ein — "
      + "von der ersten geschweiften Klammer bis zur letzten.";
    return;
  }
  const neu = (x && x.eintraege) ? x.eintraege : x;
  if (!neu || typeof neu !== "object" || Array.isArray(neu)){
    dText.textContent = "In dieser Datei stehen keine Einträge.";
    return;
  }
  let dazu = 0, ersetzt = 0, alt = 0;
  Object.keys(neu).forEach(k => {
    const e = neu[k];
    if (!e || typeof e !== "object" || !gefuellt(e)) return;
    const da = eintraege[k];
    if (!da){ eintraege[k] = e; dazu++; return; }
    if (String(e.wann || "") > String(da.wann || "")){ eintraege[k] = e; ersetzt++; }
    else alt++;
  });
  schreiben(); bauen();
  hinweis(dazu + " neu übernommen, " + ersetzt + " ersetzt, " + alt + " übergangen, weil hier Jüngeres stand."
    + (x.wer && x.wer !== wer ? " Die Datei stammt von " + x.wer + "." : "")
    + (x.variante && x.variante !== VARIANTE ? " Sie wurde zur Variante " + x.variante
        + " geschrieben, diese Seite zeigt " + VARIANTE + "." : ""));
}

dOk.addEventListener("click", () => { if (modus === "laden") einlesen(); else dlg.close(); });
dDatei.addEventListener("click", () => {
  if (modus === "bericht") speichern(feld.value, dateiName("md"), "text/markdown");
  else speichern(feld.value, dateiName("json"), "application/json");
});
document.getElementById("dlg-zu").addEventListener("click", () => dlg.close());

document.getElementById("b-druck").addEventListener("click", () => {
  document.querySelectorAll("details.woche").forEach(d => d.open = true);
  window.print();
});
document.getElementById("b-leeren").addEventListener("click", () => {
  const n = Object.keys(eintraege).length;
  if (!n) return;
  if (!confirm("Alle " + n + " Einträge auf diesem Gerät löschen? Das lässt sich nicht "
    + "rückgängig machen — geben Sie vorher die Rückmeldung aus.")) return;
  eintraege = {}; schreiben(); bauen();
});

/* ---------- Start -------------------------------------------------------- */
lesen();
meineZeile();
filterZeigen();
bauen();
</script>

