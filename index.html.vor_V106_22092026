try { wer = localStorage.getItem(S_WER) || ""; } catch(e){}
try { nurMeine = localStorage.getItem(S_NURMEIN) !== "0"; } catch(e){}
if (VORNAMEN.indexOf(wer) < 0) wer = "";
const meineFaecher = () => DATEN.faecher.filter(f => f.lk === wer).map(f => f.id);
/* meins: gehoert dem gewaehlten Vornamen. Ohne Namen ist nichts meins. */
const istMeins = id => !!wer && meineFaecher().indexOf(id) >= 0;
/* gezeigt: haengt zusaetzlich am Schalter „meine Faecher / ganzer Plan". */
const gezeigt = id => (!nurMeine || !wer) ? true : istMeins(id);
/* gezaehlt: die Kacheln meinen immer die eigene Arbeit, auch waehrend man
   sich den ganzen Plan ansieht. Sonst springen die Zahlen beim Umschalten. */
