/* ---------- Was gehoert in welche Woche ---------------------------------- */
const bausteineDer = nr => DATEN.bausteine.filter(b => b.woche === nr);
const leistungenDer = nr => DATEN.leistungen.filter(l => l.woche === nr);
const streckenDer = nr => DATEN.strecken.filter(s => s.woche === nr);

/* Alle Posten einer Woche, nach Fach gebuendelt und in der Reihenfolge der
   Faecherliste — dieselbe Ordnung wie im Turnusplan. */
function faecherDer(nr){
  const raus = [];
  DATEN.faecher.forEach(f => {
    const b = bausteineDer(nr).filter(x => x.fach === f.id);
    const l = leistungenDer(nr).filter(x => x.fach === f.id);
    const s = streckenDer(nr).filter(x => x.fach === f.id);
    if (b.length || l.length || s.length) raus.push({f:f, bausteine:b, leistungen:l, strecken:s});
  });
  return raus;
}

/* ---------- Kopfzeile einer Karte --------------------------------------- */
function bogenZeile(e){
  if (!gefuellt(e)) return "";
  const teile = [];
  if (e.status) teile.push(stufeName(e.art, e.status));
  (ACHSEN[e.art] || []).forEach(a => { if (e[a.feld]) teile.push(a.frage + ": " + achseName(e.art, a.feld, e[a.feld])); });
  if (e.text) teile.push("Vermerk");
  return teile.join(" · ");
}

function karteHtml(k, kenn, titel, klasse, marke){
  const e = holen(k);
  return '<button type="button" class="karte' + (klasse ? " " + klasse : "") + '"'
    + ' data-k="' + esc(k) + '" data-s="' + esc(e.status || "") + '">'
    + '<span class="kkenn">' + (marke ? '<span class="kmarke">' + esc(marke) + '</span>' : "")
      + esc(kenn) + '</span>'
    + '<span class="ktitel">' + esc(titel) + '</span>'
    + (bogenZeile(e) ? '<span class="kbogen">' + esc(bogenZeile(e)) + '</span>' : "")
    + '<span class="khaken">✓</span></button>';
}

/* ---------- Fortschritt -------------------------------------------------- */
function kacheln(){
  const bs = DATEN.bausteine.filter(b => gezaehlt(b.fach));
  const ls = DATEN.leistungen.filter(l => gezaehlt(l.fach));
  const abgehakt = bs.filter(b => holen(kBaustein(b)).status);
  const gehalten = bs.filter(b => holen(kBaustein(b)).status === "gehalten");
  const stdGes = bs.reduce((a, b) => a + (b.std || 0), 0);
  const stdGeh = gehalten.reduce((a, b) => a + (b.std || 0), 0);
  const lFertig = ls.filter(l => ["geschrieben","zurueck"].indexOf(holen(kLeistung(l)).status) >= 0);
  const rueck = Object.keys(eintraege).filter(k => {
    const e = eintraege[k];
    return e && (e.text || (ACHSEN[e.art] || []).some(a => e[a.feld]));
  });
  const kachel = (zahl, von, satz) =>
    '<div class="kachel"><div class="zahl">' + zahl
      + (von != null ? ' <small>von ' + von + '</small>' : "")
      + '</div><div class="satz">' + satz + '</div></div>';
  document.getElementById("kacheln").innerHTML =
      kachel(abgehakt.length, bs.length, "Bausteine abgehakt")
    + kachel(stdGeh, stdGes, "Unterrichtsstunden gehalten")
    + kachel(lFertig.length, ls.length, "Leistungen erledigt")
    + kachel(rueck.length, null, "Rückmeldungen geschrieben");
}

/* ---------- Die Wochen --------------------------------------------------- */
function wochen(){
  const ziel = document.getElementById("wochen");
  ziel.innerHTML = WOCHEN.map(w => {
    const vorbei = w.bis && w.bis < heute;
    const ist = laufend && laufend.nr === w.nr;
    const zeigen = faecherDer(w.nr).filter(g => gezeigt(g.f.id));

    /* Stand der Woche: wie viele der sichtbaren Bausteine tragen einen Haken */
    const alleB = zeigen.reduce((a, g) => a.concat(g.bausteine), []);
    const hakB = alleB.filter(b => holen(kBaustein(b)).status).length;

    const rw = holen(kWoche(w));
    const rtext = gefuellt(rw)
      ? [rw.takt ? "Takt: " + achseName("woche","takt",rw.takt) : "", rw.text || ""].filter(Boolean).join(" · ")
      : "";

    const bloecke = zeigen.map(g => {
      const f = g.f;
      const fremd = !!wer && !istMeins(f.id);
      const karten =
          g.bausteine.map(b => karteHtml(kBaustein(b), b.id + " · " + (b.std || 0) + " Std.",
              b.titel, "", b.art === "organisation" ? "Orga" : "")).join("")
        + g.leistungen.map(l => karteHtml(kLeistung(l),
              l.art + (l.nr ? " " + l.nr : "") + (l.form ? " · " + l.form : ""),
              l.titel, "leistung", l.benotet ? "benotet" : "Probe")).join("")
        + g.strecken.map(s => karteHtml(kStrecke(s),
              s.blatt + " · " + (s.minuten || "?") + " Min.",
              s.strecke + " — " + s.titel, "strecke", "Strecke")).join("");
      return '<div class="fblock' + (fremd ? " fremd" : "") + '" style="--f:var(--' + esc(f.id) + ')">'
        + '<div class="fkopf"><span class="fn">' + esc(f.name) + '</span>'
        + '<span class="flk">' + esc(f.lk || "") + '</span></div>'
        + '<div class="karten">' + karten + '</div></div>';
    }).join("");

    return '<details class="woche' + (vorbei ? " vorbei" : "") + (ist ? " jetzt" : "") + '"'
      + ' data-w="' + w.nr + '"' + (w.nr === offenNr ? " open" : "") + '>'
      + '<summary><span class="wnr">' + w.nr + '</span>'
      + '<span class="wtermin">' + esc(w.termin) + '</span>'
      + '<span class="wstand"><b>' + hakB + '</b> von ' + alleB.length + ' abgehakt</span>'
      + (w.kurz ? '<span class="wkurz">' + esc(w.kurz) + '</span>' : "")
      + '</summary>'
      + (bloecke || '<div class="fblock" style="--f:var(--line2)"><div class="fkopf">'
          + '<span class="fn">Nichts für Sie in dieser Woche</span></div></div>')
      + '<div class="rueck"><button type="button" data-k="' + esc(kWoche(w)) + '">'
      + '<span class="reyebrow">Rückblick auf die Woche</span>'
      + '<span class="rtext' + (rtext ? "" : " rleer") + '">'
      + esc(rtext || "noch nichts vermerkt — hier tippen") + '</span></button></div>'
      + '</details>';
  }).join("") + verwaistHtml();
}

/* ---------- Verwaiste Eintraege -----------------------------------------
   Eine neue Variante kann eine Kennung fallen lassen. Der Eintrag dazu wird
   nicht geloescht, sondern hier gezeigt — sonst verschwindet eine Rueckmeldung
   still, und niemand merkt es. */
function verwaist(){
  const da = new Set();
  DATEN.bausteine.forEach(b => da.add(kBaustein(b)));
  DATEN.leistungen.forEach(l => da.add(kLeistung(l)));
  DATEN.strecken.forEach(s => da.add(kStrecke(s)));
  DATEN.wochen.forEach(w => da.add(kWoche(w)));
  return Object.keys(eintraege).filter(k => !da.has(k) && gefuellt(eintraege[k]));
}
function verwaistHtml(){
  const v = verwaist();
  if (!v.length) return "";
  return '<details class="woche" style="border-color:var(--de)"><summary>'
    + '<span class="wnr">!</span><span class="wtermin">Verwaiste Einträge</span>'
    + '<span class="wstand"><b>' + v.length + '</b></span>'
    + '<span class="wkurz">Diese Kennungen gibt es im Turnusplan ' + esc(VARIANTE)
    + ' nicht mehr. Die Einträge bleiben erhalten und stehen im Bericht.</span></summary>'
    + '<div class="fblock" style="--f:var(--de)"><div class="karten">'
    + v.map(k => {
        const e = eintraege[k];
        return karteHtml(k, k.replace(/^[blsw]:/, ""), e.titel || "(ohne Titel)", "verwaist", ART_NAME[e.art] || "");
      }).join("")
    + '</div></div></details>';
}

function bauen(){ kacheln(); wochen(); }

/* ---------- Von der Kennung zurueck zum Posten --------------------------- */
function postenVon(k){
  const typ = k.slice(0, 1);
  if (typ === "b"){
    const x = DATEN.bausteine.find(b => kBaustein(b) === k);
    if (!x) return null;
    return {art:"baustein", fach:x.fach, woche:x.woche, kenn:x.id, titel:x.titel,
      meta:[(x.std || 0) + " Unterrichtsstunden", x.bis && x.bis !== x.woche ? "läuft bis Woche " + x.bis : "",
            x.art === "organisation" ? "Organisation" : "", x.anmerkung].filter(Boolean)};
  }
  if (typ === "l"){
    const x = DATEN.leistungen.find(l => kLeistung(l) === k);
    if (!x) return null;
    return {art:"leistung", fach:x.fach, woche:x.woche,
      kenn:x.art + (x.nr ? " " + x.nr : ""), titel:x.titel,
      meta:[x.form || x.format, x.benotet ? "benotet" : "Probe, unbenotet", x.datei, x.ort].filter(Boolean)};
  }
  if (typ === "s"){
    const x = DATEN.strecken.find(s => kStrecke(s) === k);
    if (!x) return null;
    return {art:"strecke", fach:x.fach, woche:x.woche, kenn:x.blatt + " · " + x.strecke, titel:x.titel,
      meta:[x.seiten, (x.minuten || "?") + " Minuten", x.ausgabe, x.zeitraum, x.pruefung].filter(Boolean)};
  }
  if (typ === "w"){
    const nr = +k.slice(2);
    const x = WOCHEN.find(w => w.nr === nr);
    if (!x) return null;
    return {art:"woche", fach:"", woche:nr, kenn:"Blockwoche " + nr, titel:"Rückblick auf die Woche",
      meta:[x.termin, x.kurz].filter(Boolean)};
  }
  /* Verwaist: der Posten steht nicht mehr im Plan, der Eintrag aber schon. */
  const e = eintraege[k];
  if (!e) return null;
  return {art:e.art || "baustein", fach:e.fach || "", woche:e.woche || 0,
    kenn:k.replace(/^[blsw]:/, ""), titel:e.titel || "(nicht mehr im Plan)",
    meta:["Diese Kennung gibt es im Turnusplan " + VARIANTE + " nicht mehr."], weg:true};
}

/* ---------- Der Bogen ---------------------------------------------------- */
const hg = document.getElementById("hg");
let offenK = null;

hg.addEventListener("click", e => { if (e.target === hg) bogenSchliessen(); });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !hg.hidden) bogenSchliessen(); });
function bogenSchliessen(){ offenK = null; hg.hidden = true; hg.innerHTML = ""; }

function bogenOeffnen(k){
  const p = postenVon(k);
  if (!p) return;
  offenK = k;
  const e = holen(k);
  const f = p.fach ? fachVon(p.fach) : null;
  const stufen = STUFEN[p.art] || [];
  const achsen = ACHSEN[p.art] || [];

  const b = document.createElement("div");
  b.className = "bogen";
  b.style.setProperty("--f", f ? "var(--" + f.id + ")" : "var(--ink)");
  b.innerHTML =
      '<button class="schliessen" type="button" id="b-zu">schließen</button>'
    + '<div class="bkenn">' + (f ? esc(f.name) + " · " : "") + esc(ART_NAME[p.art]) + " · " + esc(p.kenn) + '</div>'
    + '<h2>' + esc(p.titel) + '</h2>'
    + '<div class="bmeta">Blockwoche ' + p.woche
      + (p.meta.length ? '<br>' + p.meta.map(esc).join(' · ') : "") + '</div>'
    + (stufen.length
        ? '<h3>Stand</h3><ul class="leiter">' + stufen.map((s, i) =>
            '<li><button type="button" data-stufe="' + s.id + '" aria-pressed="' + (s.id === e.status) + '">'
            + '<span class="stufe">' + (i + 1) + '</span>'
            + '<span><span class="lbl">' + esc(s.label) + '</span>'
            + '<span class="erkl">' + esc(s.erkl) + '</span></span>'
            + (s.id === e.status ? '<span class="haken">✓</span>' : "")
            + '</button></li>').join("") + '</ul>'
        : "")
    + (achsen.length
        ? '<h3>Wie ist es gelaufen</h3>' + achsen.map(a =>
            '<div class="achse"><div class="afrage">' + esc(a.frage) + '</div><div class="awerte">'
            + a.werte.map(w =>
                '<button type="button" data-achse="' + a.feld + '" data-wert="' + w[0] + '"'
                + ' aria-pressed="' + (e[a.feld] === w[0]) + '">' + esc(w[1]) + '</button>').join("")
            + '</div></div>').join("")
        : "")
    + '<h3>Vermerk</h3>'
    + '<textarea id="b-text" maxlength="600" placeholder="'
      + (p.art === "woche" ? "Was ist liegengeblieben? Wie war der Takt?"
         : p.art === "leistung" ? "Wie ist sie ausgefallen? Was war unklar?"
         : "Was ändern? Was hat gefehlt, was war zu viel?") + '"></textarea>'
    + '<div class="zaehler" id="b-zaehler"></div>'
    + '<div class="spur" id="b-spur"></div>'
    + '<div class="bzeile">'
      + '<button class="knopf warn" type="button" id="b-weg">Eintrag zurücknehmen</button>'
    + '</div>';

  hg.innerHTML = ""; hg.appendChild(b); hg.hidden = false;

  const ta = b.querySelector("#b-text");
  ta.value = e.text || "";
  const zaehler = () => {
    b.querySelector("#b-zaehler").textContent = ta.value.length + " von 600 Zeichen";
  };
  zaehler();
  b.querySelector("#b-spur").textContent = e.wann
    ? "zuletzt gesetzt von " + (e.wer || "ohne Namen") + " am "
      + new Date(e.wann).toLocaleString("de-DE",
          {day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit"})
      + (e.variante && e.variante !== VARIANTE ? " · zur Variante " + e.variante : "")
    : "noch nichts eingetragen";
  b.querySelector("#b-weg").disabled = !gefuellt(e);

  b.querySelector("#b-zu").addEventListener("click", bogenSchliessen);
  /* Beim Umschalten geht der Vermerk mit in den Eintrag: sonst faellt weg,
     was in den letzten 600 ms getippt wurde. */
  b.querySelectorAll("[data-stufe]").forEach(el => el.addEventListener("click", () => {
    const jetzt = holen(k).status;
    setzen(k, p, {status: jetzt === el.dataset.stufe ? "" : el.dataset.stufe, text: ta.value});
  }));
  b.querySelectorAll("[data-achse]").forEach(el => el.addEventListener("click", () => {
    const feld = el.dataset.achse, wert = el.dataset.wert;
    const patch = {text: ta.value};
    patch[feld] = holen(k)[feld] === wert ? "" : wert;
    setzen(k, p, patch);
  }));
  let timer;
  ta.addEventListener("input", () => {
    zaehler();
    clearTimeout(timer);
    const wert = ta.value;
    timer = setTimeout(() => setzen(k, p, {text: wert}), 600);
  });
  b.querySelector("#b-weg").addEventListener("click", () => {
    if (!confirm("Den Eintrag zu „" + p.titel.slice(0, 60) + "“ zurücknehmen?")) return;
    delete eintraege[k];
    schreiben(); frischen(k); bogenSchliessen();
  });
  b.querySelector("#b-zu").focus();
}

/* Der offene Bogen wird an Ort und Stelle nachgezogen — nie neu gesetzt.
   Ein Neuaufbau warf den Kursor aus dem Vermerkfeld und scrollte das Blatt an
   den Kopf zurueck, was auf dem Handy jedes zweite Antippen gekostet haette. */
function bogenFrischen(k){
  const b = hg.querySelector(".bogen");
  if (!b || offenK !== k) return;
  const e = holen(k);
  b.querySelectorAll("[data-stufe]").forEach(el => {
    const an = el.dataset.stufe === e.status;
    el.setAttribute("aria-pressed", String(an));
    const h = el.querySelector(".haken");
    if (an && !h){
      const sp = document.createElement("span");
      sp.className = "haken"; sp.textContent = "✓"; el.appendChild(sp);
    } else if (!an && h) h.remove();
  });
  b.querySelectorAll("[data-achse]").forEach(el =>
    el.setAttribute("aria-pressed", String(e[el.dataset.achse] === el.dataset.wert)));
  b.querySelector("#b-spur").textContent = e.wann
    ? "zuletzt gesetzt von " + (e.wer || "ohne Namen") + " am "
      + new Date(e.wann).toLocaleString("de-DE",
          {day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit"})
      + (e.variante && e.variante !== VARIANTE ? " · zur Variante " + e.variante : "")
    : "noch nichts eingetragen";
  b.querySelector("#b-weg").disabled = !gefuellt(e);
}

function setzen(k, p, patch){
  const alt = holen(k);
  const neu = Object.assign({status:"", text:""}, alt, patch, {
    art:p.art, fach:p.fach, woche:p.woche, kennung:k.replace(/^[blsw]:/, ""), titel:p.titel,
    wer:wer || "ohne Namen", wann:new Date().toISOString(), variante:VARIANTE});
  eintraege[k] = neu;
  if (!gefuellt(neu)) delete eintraege[k];
  schreiben();
  frischen(k);
  bogenFrischen(k);
}

/* Nur die betroffene Karte nachziehen statt die Seite neu zu setzen — sonst
   klappen die Wochen zu und die Seite springt unter der Hand weg. */
function frischen(k){
  kacheln();
  const e = holen(k);
  document.querySelectorAll('[data-k="' + k + '"]').forEach(el => {
    if (el.classList.contains("karte")){
      el.dataset.s = e.status || "";
      const z = bogenZeile(e);
      let zeile = el.querySelector(".kbogen");
      if (z && !zeile){
        zeile = document.createElement("span");
        zeile.className = "kbogen";
        el.insertBefore(zeile, el.querySelector(".khaken"));
      }
      if (z) zeile.textContent = z; else if (zeile) zeile.remove();
    } else {
      const t = gefuellt(e)
        ? [e.takt ? "Takt: " + achseName("woche","takt",e.takt) : "", e.text || ""].filter(Boolean).join(" · ")
        : "";
      const sp = el.querySelector(".rtext");
      sp.className = "rtext" + (t ? "" : " rleer");
      sp.textContent = t || "noch nichts vermerkt — hier tippen";
    }
  });
  document.querySelectorAll("details.woche[data-w]").forEach(d => {
    const bs = [...d.querySelectorAll('.karte[data-k^="b:"]')];
    const st = d.querySelector(".wstand");
    if (st) st.innerHTML = "<b>" + bs.filter(x => x.dataset.s).length + "</b> von " + bs.length + " abgehakt";
  });
}

/* ---------- Klicks ------------------------------------------------------- */
document.getElementById("wochen").addEventListener("click", e => {
  const karte = e.target.closest(".karte");
  if (karte) return bogenOeffnen(karte.dataset.k);
  const rueck = e.target.closest(".rueck button");
  if (rueck) return bogenOeffnen(rueck.dataset.k);
});

